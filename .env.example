# Local (défaut) : SQLite dans data/store/recyclage.db — ne rien mettre ci-dessous.
# Cloud / Neon : décommentez DATABASE_URL
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

APP_DEFAULT_USER=admin
APP_DEFAULT_PASSWORD=leadconnect

# Streamlit Cloud — temporaire si login impossible :
# APP_RESET_PASSWORD_ON_START=true

# Migration SQLite → PostgreSQL (one-shot) :
# export DATABASE_URL="postgresql://..."
# python3 scripts/migrate_sqlite_to_postgres.py
