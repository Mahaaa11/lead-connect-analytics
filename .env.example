# PostgreSQL (Neon, Supabase, etc.) — requis en local et cloud
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

APP_DEFAULT_USER=admin
APP_DEFAULT_PASSWORD=leadconnect

# Streamlit Cloud — temporaire si login impossible :
# APP_RESET_PASSWORD_ON_START=true

# Migration SQLite → PostgreSQL (one-shot, si vous avez encore un ancien fichier local) :
# python3 scripts/migrate_sqlite_to_postgres.py
