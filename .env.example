# PostgreSQL (obligatoire) — copiez ce fichier en .env et renseignez votre URL Neon.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

APP_DEFAULT_USER=admin
APP_DEFAULT_PASSWORD=leadconnect

# Déploiement Streamlit Cloud — ajoutez temporairement si login impossible :
# APP_RESET_PASSWORD_ON_START=true

# Migration one-shot depuis l'ancienne base SQLite locale (optionnel) :
# python3 scripts/migrate_sqlite_to_postgres.py
