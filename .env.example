# Local (défaut) : SQLite dans data/store/recyclage.db — lance ./run.sh
# (FORCE_SQLITE=1, Neon/Postgres ignorés).

# --- Cloud Streamlit : TiDB UNIQUEMENT (secrets, pas Neon) ---
# Option A — URL complète :
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@gatewayXX.eu-central-1.prod.aws.tidbcloud.com:4000/test

# Option B — variables séparées (comme AI Call Simulator) :
# MYSQL_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
# MYSQL_PORT=4000
# MYSQL_USER=xxxxxxxx.root
# MYSQL_PASSWORD=votre_password
# MYSQL_DATABASE=test
MYSQL_SSL=true

APP_DEFAULT_USER=admin
APP_DEFAULT_PASSWORD=leadconnect

# Streamlit Cloud — temporaire si login impossible :
# APP_RESET_PASSWORD_ON_START=true

# Migration SQLite → TiDB (one-shot) :
# export MYSQL_HOST=... MYSQL_USER=... MYSQL_PASSWORD=... MYSQL_DATABASE=test MYSQL_SSL=true
# python3 scripts/migrate_sqlite_to_tidb.py
# ou :
# export DATABASE_URL="mysql+pymysql://..."
# python3 scripts/migrate_sqlite_to_tidb.py
